# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- AI API configuration ---
# API key for the LLM provider (e.g. Anthropic)
ANTHROPIC_API_KEY=

# Model name to use for CafeBot's responses (defaults to claude-haiku-4-5-20251001 if left blank)
AI_MODEL=

# Optional: override the default API base URL (leave blank to use the provider default)
AI_API_BASE_URL=

# Optional: request limits to help keep usage low-cost
AI_MAX_TOKENS=

# --- Server configuration ---
# Port the backend server will run on
PORT=3000
